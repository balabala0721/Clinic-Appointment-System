@model int
@* Friendly error page for 404 / 500 / other codes. Rendered by StatusController. *@
@{
    var (title, text, icon) = Model switch
    {
        404 => ("We can't find that page", "The link may be old or mistyped. Nothing has been changed.", "bi-signpost-split"),
        403 => ("This page isn't available for your account", "Your role doesn't have access to it.", "bi-shield-lock"),
        500 => ("Something went wrong on our side", "Please try again in a moment. If it keeps happening, contact the clinic.", "bi-tools"),
        _ => ("Something went wrong", "Please go back and try again.", "bi-exclamation-circle")
    };
    ViewData["Title"] = title;
    var home = AppNav.Home(User);
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<div class="card-clean dialog-card">
    <div class="empty-state">
        <div class="empty-icon" aria-hidden="true"><i class="bi @icon"></i></div>
        <h1 class="empty-title h4">@title</h1>
        <p class="empty-text">@text <span class="d-block small mt-1">Error @Model</span></p>
        <a class="btn btn-primary" asp-controller="@home.Controller" asp-action="@home.Action">
            @(signedIn ? "Go to my dashboard" : "Go to login")
        </a>
    </div>
</div>
