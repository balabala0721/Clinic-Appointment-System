@model IEnumerable<ClinicSystem.Models.ViewModels.AppointmentReportView>

@{
    ViewData["Title"] = "Appointment Report";
}

<div class="container mt-4">

    <h2>Appointment Report</h2>
    <p class="text-muted">
        View your appointment records.
    </p>

    <div class="card shadow-sm mt-3">
        <div class="card-body">

            <h5 class="mb-3">Appointment Records</h5>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    No appointment records available.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Appointment ID</th>
                                <th>Appointment Date</th>
                                <th>Start Time</th>
                                <th>Doctor Name</th>
                                <th>Specialisation</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.AppointmentId</td>
                                    <td>@item.AppointmentDate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.StartTime.ToString("hh:mm tt")</td>
                                    <td>@item.DoctorName</td>
                                    <td>@item.Specialisation</td>
                                    <td>@item.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <a asp-controller="Reports"
               asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>
    </div>
</div>
