@model ClinicSystem.Models.Entities.GeneratedReportHistory

@{
    ViewData["Title"] = "Report Details";
}

<div class="container mt-4">
    <h2>Report Details</h2>

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <p>
                <strong>Report ID:</strong>
                @Model.ReportId
            </p>

            <p>
                <strong>Report Type:</strong>
                @Model.ReportType
            </p>

            <p>
                <strong>Generated Date:</strong>
                @Model.GeneratedDateTime.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>User ID:</strong>
                @Model.UserId
            </p>

            <a asp-action="History" class="btn btn-secondary">
                Back to History
            </a>
        </div>
    </div>
</div>
