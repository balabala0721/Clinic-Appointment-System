@model ClinicSystem.Models.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Report Management";
}

<h2>Report Management</h2>

<div class="row">

    <div class="col-md-3">
        <h5>Total Patients</h5>
        <h3>@Model.TotalPatients</h3>
    </div>

    <div class="col-md-3">
        <h5>Total Doctors</h5>
        <h3>@Model.TotalDoctors</h3>
    </div>

    <div class="col-md-3">
        <h5>Total Appointments</h5>
        <h3>@Model.TotalAppointments</h3>
    </div>

    <div class="col-md-3">
        <h5>Total Reports</h5>
        <h3>@Model.TotalReports</h3>
    </div>

</div>

<hr />

<a asp-controller="Reports"
   asp-action="Generate"
   class="btn btn-primary">
    Generate Report
</a>

<a asp-controller="Reports"
   asp-action="History"
   class="btn btn-secondary">
    Report History
</a>