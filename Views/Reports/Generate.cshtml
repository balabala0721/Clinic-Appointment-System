@model ClinicSystem.Models.ViewModels.GenerateReportViewModel

@{
    ViewData["Title"] = "Generate Report";
}

<div class="container mt-4">
    <h2>Generate Report</h2>
    <p class="text-muted">Select your report type and customize the report settings.</p>

    <div class="card shadow-sm mt-3">
        <div class="card-body">

            <form asp-controller="Reports"
                  asp-action="Generate"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <!-- Report Type -->
                <div class="mb-3">
                    <label asp-for="ReportType" class="form-label">
                        Report Type
                    </label>

                    <select asp-for="ReportType"
                            asp-items="ViewBag.ReportTypes"
                            class="form-select">
                        <option value="">-- Select Report Type --</option>
                    </select>

                    <span asp-validation-for="ReportType"
                          class="text-danger"></span>
                </div>

                <!-- Start Date -->
                <div class="mb-3">
                    <label asp-for="StartDate" class="form-label">
                        Start Date
                    </label>

                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="StartDate"
                          class="text-danger"></span>
                </div>

                <!-- End Date -->
                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label">
                        End Date
                    </label>

                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EndDate"
                          class="text-danger"></span>
                </div>

                <!-- Additional Options -->
                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="IncludeSummary"
                               class="form-check-input" />

                        <label asp-for="IncludeSummary"
                               class="form-check-label">
                            Include Summary
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="GroupByDepartment"
                               class="form-check-input" />

                        <label asp-for="GroupByDepartment"
                               class="form-check-label">
                            Group By Department
                        </label>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        Generate Report
                    </button>

                    <a asp-controller="Reports"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}