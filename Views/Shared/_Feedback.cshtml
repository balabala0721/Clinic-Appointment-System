@* Containers used by clinic.js: toasts (Clinic.toast) and the confirmation modal (Clinic.confirm).
   Text is filled in by JS with .text(), so nothing here needs encoding. *@
<div id="toast-stack" class="toast-stack" aria-live="polite" aria-atomic="false"></div>

<div class="modal fade" id="confirm-modal" tabindex="-1" aria-labelledby="confirm-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="confirm-modal-title">Are you sure?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="confirm-message mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary confirm-cancel" data-bs-dismiss="modal">Go back</button>
                <button type="button" class="btn btn-danger confirm-ok">Confirm</button>
            </div>
        </div>
    </div>
</div>
