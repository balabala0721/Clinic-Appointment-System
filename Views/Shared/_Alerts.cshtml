@* Messages set by controllers after a redirect.
   Keys: TempData["Success"] / ["Error"] (appointments, schedules) and
         TempData["SuccessMessage"] / ["ErrorMessage"] (Drugs module) - both are shown here.
   Success -> toast (clinic.js reads data-toast). Error -> stays visible at the top of the page.
   #ajax-alert is the fallback box Clinic.showAlert() uses when a failure has no inline spot. *@
@{
    var ok = (TempData["Success"] ?? TempData["SuccessMessage"]) as string;
    var err = (TempData["Error"] ?? TempData["ErrorMessage"]) as string;
}
@if (!string.IsNullOrEmpty(ok))
{
    <div hidden data-toast="@ok"></div>
}
@if (!string.IsNullOrEmpty(err))
{
    <div class="alert alert-danger" role="alert" data-server-error><i class="bi bi-exclamation-circle" aria-hidden="true"></i><div>@err</div></div>
}
<div id="ajax-alert" class="alert d-none" role="alert"></div>
