@*
    Shared layout for every page.
    - Signed in:  sidebar (role menu from Helpers/AppNav.cs) + content area.
                  Desktop: sidebar always visible. Below 992px: top bar with a menu button
                  that opens the sidebar as a drawer (Bootstrap .offcanvas-lg).
    - Signed out: centred page without a sidebar (login, register, error pages).
    Styles: wwwroot/css/theme.css.  Shared JS: wwwroot/js/clinic.js.
*@
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var role = AppNav.RoleOf(User);
    var displayName = User.Identity?.Name ?? "";
    var home = AppNav.Home(User);
    var showChat = User.IsInRole(Roles.Patient);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @ClinicInfo.Name</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="@(showChat ? "has-chat" : "")">
    <a class="skip-link" href="#main">Skip to main content</a>

    @* One token for every AJAX POST on the page - read by clinic.js *@
    @Html.AntiForgeryToken()

    @if (signedIn)
    {
        <div class="app-shell">
            <aside class="app-sidebar offcanvas-lg offcanvas-start" id="sidebar" tabindex="-1" aria-labelledby="sidebar-title">
                <div class="offcanvas-header">
                    <span class="brand" id="sidebar-title"><span class="brand-mark" aria-hidden="true"><i class="bi bi-heart-pulse"></i></span>@ClinicInfo.Name</span>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close menu"></button>
                </div>
                <div class="offcanvas-body">
                    <a class="brand d-none d-lg-flex" asp-controller="@home.Controller" asp-action="@home.Action">
                        <span class="brand-mark" aria-hidden="true"><i class="bi bi-heart-pulse"></i></span>@ClinicInfo.Name
                    </a>

                    <nav aria-label="Main menu">
                        <partial name="_Nav" />
                    </nav>

                    <div class="user-box">
                        <span class="avatar" aria-hidden="true">@Ui.Initials(displayName)</span>
                        <div class="min-w-0">
                            <div class="user-name">@displayName</div>
                            <div class="user-role">@AppNav.RoleLabel(role)</div>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="btn-logout m-0">
                            <button class="btn btn-secondary btn-sm btn-icon" data-no-busy title="Log out" aria-label="Log out">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <div class="app-main">
                <header class="app-topbar">
                    <button class="btn btn-secondary btn-icon" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar"
                            aria-controls="sidebar" aria-label="Open menu">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                    <a class="brand" asp-controller="@home.Controller" asp-action="@home.Action">
                        <span class="brand-mark" aria-hidden="true"><i class="bi bi-heart-pulse"></i></span>@ClinicInfo.Name
                    </a>
                    <span class="avatar ms-auto" title="@displayName (@AppNav.RoleLabel(role))">@Ui.Initials(displayName)</span>
                </header>

                <main id="main" class="app-content" tabindex="-1">
                    <partial name="_Alerts" />
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <div class="auth-shell">
            <span class="brand"><span class="brand-mark" aria-hidden="true"><i class="bi bi-heart-pulse"></i></span>@ClinicInfo.Name</span>
            <main id="main" class="auth-content" tabindex="-1">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
        </div>
    }

    <partial name="_Feedback" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/clinic.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @* Floating AI support chat - patients only *@
    @if (showChat)
    {
        <partial name="_SupportChat" />
        <script src="~/js/support-chat.js" asp-append-version="true"></script>
    }
</body>
</html>
