@model DoctorWeekViewModel
@*
    One doctor's week. Used for:
      - DoctorSchedules/Mine     (doctor: own week + appointments + leave requests)
      - DoctorSchedules/Doctor   (patients/staff: working hours only)
*@
@{
    var own = Model.IsOwnSchedule;
    ViewData["Title"] = own ? "My schedule" : Model.Doctor.User.FullName;
    var action = own ? "Mine" : "Doctor";
    var routeId = own ? (int?)null : Model.Doctor.DoctorId;
    var today = ClinicClock.Today;
    var weekEnd = Model.WeekStart.AddDays(6);
}

<div class="page-header">
    <div>
        <h1>@(own ? "My schedule" : Model.Doctor.User.FullName)</h1>
        <p class="page-subtitle">@Model.Doctor.Specialisation?.Name</p>
    </div>
    <div class="page-actions">
        @if (own)
        {
            <a class="btn btn-secondary" href="#leave"><i class="bi bi-airplane" aria-hidden="true"></i> Request leave</a>
        }
        else if (User.IsInRole(Roles.Patient))
        {
            <a asp-controller="Appointments" asp-action="Book" asp-route-doctorId="@Model.Doctor.DoctorId" class="btn btn-primary">
                <i class="bi bi-calendar-plus" aria-hidden="true"></i> Book with this doctor
            </a>
        }
    </div>
</div>

<nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3" aria-label="Week">
    <a class="btn btn-secondary btn-sm" asp-action="@action" asp-route-id="@routeId" asp-route-week="@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")">
        <i class="bi bi-chevron-left" aria-hidden="true"></i> Previous week
    </a>
    <strong>@Ui.Date(Model.WeekStart) – @Ui.Date(weekEnd)</strong>
    <a class="btn btn-secondary btn-sm" asp-action="@action" asp-route-id="@routeId" asp-route-week="@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")">
        Next week <i class="bi bi-chevron-right" aria-hidden="true"></i>
    </a>
</nav>

<div class="week-grid mb-5">
    @for (var i = 0; i < 7; i++)
    {
        var date = Model.WeekStart.AddDays(i);
        var schedule = ScheduleRules.ScheduleFor(Model.Schedules, date);
        var wholeDayLeave = Model.Leaves.Any(l => l.IsWholeDay && l.StartDate <= date && l.EndDate >= date);
        var partialLeave = Model.Leaves.Where(l => !l.IsWholeDay && l.StartDate <= date && l.EndDate >= date).ToList();
        var off = schedule == null || wholeDayLeave;
        var dayAppts = Model.Appointments.Where(a => a.AppointmentDate == date).ToList();

        <section class="week-day @(off ? "off" : "") @(date == today ? "is-today" : "")" aria-label="@Ui.DayDate(date)">
            <div class="week-date">
                <span>@date.ToString("ddd") @date.Day</span>
                @if (date == today) { <span class="small">Today</span> }
            </div>
            @if (wholeDayLeave)
            {
                <span class="leave-tag">On leave</span>
            }
            else if (schedule == null)
            {
                <div>Not working</div>
            }
            else
            {
                <div class="hours">@Ui.Time(schedule.StartTime) – @Ui.Time(schedule.EndTime)</div>
                @if (schedule.BreakStart.HasValue)
                {
                    <div class="text-muted small">Break @Ui.Time(schedule.BreakStart.Value) – @Ui.Time(schedule.BreakEnd!.Value)</div>
                }
                @foreach (var l in partialLeave)
                {
                    <span class="leave-tag">Away @Ui.Time(l.StartTime!.Value) – @Ui.Time(l.EndTime!.Value)</span>
                }
                @foreach (var a in dayAppts)
                {
                    <div class="appt">
                        <strong>@Ui.Time(a.StartTime)</strong> @a.Patient?.User.FullName
                        @if (!string.IsNullOrEmpty(a.ReasonForVisit))
                        {
                            <div class="text-muted small">@a.ReasonForVisit</div>
                        }
                    </div>
                }
                @if (own && dayAppts.Count == 0)
                {
                    <div class="text-muted small mt-2">No bookings</div>
                }
            }
        </section>
    }
</div>

@if (own)
{
    <section id="leave" aria-labelledby="leave-title" class="row g-4">
        <div class="col-lg-5">
            <form asp-action="RequestLeave" method="post" class="card-clean">
                <h2 class="section-title" id="leave-title">Request leave</h2>
                <p class="text-muted small">The clinic admin reviews each request. Patients already booked will be contacted if it's approved.</p>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label" asp-for="LeaveForm.StartDate">From</label>
                        <input asp-for="LeaveForm.StartDate" type="date" class="form-control" required />
                        <span asp-validation-for="LeaveForm.StartDate"></span>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" asp-for="LeaveForm.EndDate">To</label>
                        <input asp-for="LeaveForm.EndDate" type="date" class="form-control" required />
                        <span asp-validation-for="LeaveForm.EndDate"></span>
                    </div>
                </div>
                <div class="row g-3 mb-1">
                    <div class="col-sm-6">
                        <label class="form-label" asp-for="LeaveForm.StartTime">Start time <span class="optional">(optional)</span></label>
                        <input asp-for="LeaveForm.StartTime" type="time" class="form-control" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" asp-for="LeaveForm.EndTime">End time <span class="optional">(optional)</span></label>
                        <input asp-for="LeaveForm.EndTime" type="time" class="form-control" />
                    </div>
                </div>
                <div class="form-text mb-3">Leave both times empty for full-day leave.</div>
                <label class="form-label" asp-for="LeaveForm.Reason">Reason</label>
                <input asp-for="LeaveForm.Reason" class="form-control mb-4" placeholder="e.g. Medical conference" />
                <button class="btn btn-primary" data-busy-text="Sending...">Send request</button>
            </form>
        </div>

        <div class="col-lg-7">
            <div class="card-clean">
                <h2 class="section-title">My leave requests</h2>
                @if (Model.MyLeaveRequests.Count == 0)
                {
                    <div class="empty-state is-compact">
                        <div class="empty-icon" aria-hidden="true"><i class="bi bi-airplane"></i></div>
                        <div class="empty-title">No current or upcoming leave</div>
                        <p class="empty-text mb-0">Requests you send appear here with their status.</p>
                    </div>
                }
                else
                {
                    <div class="appt-list">
                        @foreach (var l in Model.MyLeaveRequests)
                        {
                            <div class="appt-row">
                                <div class="appt-head">
                                    <div>
                                        <div class="appt-when">
                                            @Ui.Date(l.StartDate)@(l.EndDate != l.StartDate ? " – " + Ui.Date(l.EndDate) : "")
                                        </div>
                                        <div class="appt-who">
                                            @(l.IsWholeDay ? "Full day" : $"{Ui.Time(l.StartTime)} – {Ui.Time(l.EndTime)}")
                                            @if (!string.IsNullOrWhiteSpace(l.Reason)) { <text> &middot; @l.Reason</text> }
                                        </div>
                                    </div>
                                    @Ui.StatusBadge(l.Status)
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@section Scripts {
    @if (own) { <partial name="_ValidationScriptsPartial" /> }
}
