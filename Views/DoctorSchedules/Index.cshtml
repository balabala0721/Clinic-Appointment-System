@model ScheduleIndexViewModel
@* Doctor schedules overview. Admin: manage; Staff: view only. *@
@{
    ViewData["Title"] = "Doctor schedules";
    var isAdmin = User.IsInRole(Roles.Admin);
    var filtered = Model.SpecialisationId.HasValue || !string.IsNullOrEmpty(Model.Search);
}

<div class="page-header">
    <div>
        <h1>Doctor schedules</h1>
        <p class="page-subtitle">@(isAdmin ? "Working hours for every doctor. Open a doctor to change their timetable or record leave." : "Working hours for every doctor.")</p>
    </div>
    @if (isAdmin)
    {
        <div class="page-actions">
            <a asp-action="Leaves" class="btn btn-secondary">
                <i class="bi bi-airplane" aria-hidden="true"></i> Leave requests
                @if (Model.PendingLeaveCount > 0) { <span class="status-badge status-pending">@Model.PendingLeaveCount waiting</span> }
            </a>
        </div>
    }
</div>

@if (Model.ConflictCount > 0)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <div>
            <strong>@Model.ConflictCount booked @(Model.ConflictCount == 1 ? "appointment no longer fits" : "appointments no longer fit")</strong> a doctor's schedule or leave.
            <a asp-action="Conflicts">Review conflicts</a>
        </div>
    </div>
}

<form method="get" class="card-clean filter-bar" role="search" aria-label="Filter doctors">
    <div class="filter-field">
        <label class="form-label" for="f-spec">Specialisation</label>
        <select id="f-spec" name="specialisationId" class="form-select">
            <option value="">All specialisations</option>
            @foreach (var s in Model.Specialisations)
            {
                <option value="@s.SpecialisationId" selected="@(s.SpecialisationId == Model.SpecialisationId)">@s.Name</option>
            }
        </select>
    </div>
    <div class="filter-field is-wide">
        <label class="form-label" for="f-search">Doctor name</label>
        <input id="f-search" name="search" value="@Model.Search" class="form-control" placeholder="e.g. Tan" />
    </div>
    <div class="filter-actions">
        <button class="btn btn-primary">Apply</button>
        @if (filtered) { <a class="btn btn-secondary" asp-action="Index">Clear</a> }
    </div>
</form>

<div class="card-clean @(Model.Rows.Count > 0 ? "card-table" : "")">
    @if (Model.Rows.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon" aria-hidden="true"><i class="bi bi-person-badge"></i></div>
            <div class="empty-title">No doctors match</div>
            <p class="empty-text">Try another name or specialisation.</p>
            @if (filtered) { <a class="btn btn-outline-primary" asp-action="Index">Clear filters</a> }
        </div>
    }
    else
    {
        <table class="table table-stack">
            <thead><tr><th scope="col">Doctor</th><th scope="col">Specialisation</th><th scope="col">Working days</th><th scope="col" class="actions"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td data-label="Doctor"><strong>@row.Doctor.User.FullName</strong></td>
                        <td data-label="Specialisation">@row.Doctor.Specialisation?.Name</td>
                        <td data-label="Working days" class="small">
                            @if (row.Schedules.Count == 0)
                            {
                                <span class="status-badge status-noshow">No schedule set</span>
                            }
                            @foreach (var s in row.Schedules)
                            {
                                <div>@Ui.DayName(s.DayOfWeek, shortName: true) &middot; @Ui.TimeRange(s.StartTime, s.EndTime)</div>
                            }
                        </td>
                        <td class="actions">
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-doctorId="@row.Doctor.DoctorId" class="btn btn-secondary btn-sm" aria-label="Manage schedule for @row.Doctor.User.FullName">Manage</a>
                            }
                            else
                            {
                                <a asp-action="Doctor" asp-route-id="@row.Doctor.DoctorId" class="btn btn-secondary btn-sm" aria-label="View week for @row.Doctor.User.FullName">View week</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
