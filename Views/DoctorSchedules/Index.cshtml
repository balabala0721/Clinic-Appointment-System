@model ScheduleIndexViewModel
@{
    ViewData["Title"] = "Doctor schedules";
    var isAdmin = User.IsInRole(Roles.Admin);   // staff: view only
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h4 mb-0">Doctor schedules</h1>
    <div class="d-flex gap-2">
        @if (isAdmin)
        {
            <a asp-action="Leaves" class="btn btn-outline-secondary btn-sm">
                Leave requests @if (Model.PendingLeaveCount > 0) { <span class="badge bg-warning text-dark">@Model.PendingLeaveCount</span> }
            </a>
        }
        <a asp-action="Conflicts" class="btn btn-sm @(Model.ConflictCount > 0 ? "btn-danger" : "btn-outline-secondary")">
            Conflicts @if (Model.ConflictCount > 0) { <span class="badge bg-light text-dark">@Model.ConflictCount</span> }
        </a>
    </div>
</div>

<form method="get" class="card-clean row g-2 align-items-end mb-4">
    <div class="col-md-5">
        <label class="form-label small">Specialisation</label>
        <select name="specialisationId" class="form-select form-select-sm">
            <option value="">All</option>
            @foreach (var s in Model.Specialisations)
            {
                <option value="@s.SpecialisationId" selected="@(s.SpecialisationId == Model.SpecialisationId)">@s.Name</option>
            }
        </select>
    </div>
    <div class="col-md-5">
        <label class="form-label small">Doctor name</label>
        <input name="search" value="@Model.Search" class="form-control form-control-sm" />
    </div>
    <div class="col-md-2"><button class="btn btn-primary btn-sm w-100">Filter</button></div>
</form>

<div class="card-clean">
    <table class="table table-sm align-middle mb-0">
        <thead><tr><th>Doctor</th><th>Specialisation</th><th>Working days</th><th></th></tr></thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.Doctor.FullName</td>
                    <td>@row.Doctor.Specialisation?.Name</td>
                    <td class="small">
                        @if (row.Schedules.Count == 0)
                        {
                            <span class="text-danger">No schedule set</span>
                        }
                        @foreach (var s in row.Schedules)
                        {
                            <div>@(((System.DayOfWeek)s.DayOfWeek).ToString()[..3]) @s.StartTime.ToString("HH:mm")-@s.EndTime.ToString("HH:mm")</div>
                        }
                    </td>
                    <td class="text-end">
                        @if (isAdmin)
                        {
                            <a asp-action="Edit" asp-route-doctorId="@row.Doctor.DoctorId" class="btn btn-outline-primary btn-sm">Manage</a>
                        }
                        else
                        {
                            <a asp-action="Doctor" asp-route-id="@row.Doctor.DoctorId" class="btn btn-outline-secondary btn-sm">View</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
