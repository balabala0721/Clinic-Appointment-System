@model EditScheduleViewModel
@{
    ViewData["Title"] = "Schedule - " + Model.Doctor.User.FullName;
    var days = Enumerable.Range(0, 7).Select(i => (Value: i, Name: ((System.DayOfWeek)i).ToString())).ToList();
    var editing = Model.Form.ScheduleId != 0;
}

<a asp-action="Index" class="small">&larr; All schedules</a>
<h1 class="h4 mt-2 mb-4">@Model.Doctor.User.FullName <span class="text-muted h6">@Model.Doctor.Specialisation?.Name</span></h1>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card-clean mb-4">
            <h2 class="h6 mb-3">Weekly timetable</h2>
            @if (Model.Schedules.Count == 0)
            {
                <p class="text-muted mb-0">No working days yet. Add one on the right.</p>
            }
            else
            {
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Day</th><th>Hours</th><th>Break</th><th>Slot</th><th>Effective</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.Schedules)
                        {
                            <tr>
                                <td>@(((System.DayOfWeek)s.DayOfWeek).ToString())</td>
                                <td>@s.StartTime.ToString("HH:mm")-@s.EndTime.ToString("HH:mm")</td>
                                <td>@(s.BreakStart.HasValue ? $"{s.BreakStart:HH:mm}-{s.BreakEnd:HH:mm}" : "-")</td>
                                <td>@s.SlotDurationMinutes min</td>
                                <td class="small">@s.EffectiveFrom.ToString("d MMM yy") @(s.EffectiveTo.HasValue ? "to " + s.EffectiveTo.Value.ToString("d MMM yy") : "onwards")</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-doctorId="@s.DoctorId" asp-route-scheduleId="@s.ScheduleId" class="btn btn-link btn-sm">Edit</a>
                                    <form asp-action="Deactivate" method="post" class="d-inline" onsubmit="return confirm('Remove this working day?')">
                                        <input type="hidden" name="scheduleId" value="@s.ScheduleId" />
                                        <input type="hidden" name="doctorId" value="@s.DoctorId" />
                                        <button class="btn btn-link btn-sm text-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="card-clean">
            <h2 class="h6 mb-3">Upcoming leave</h2>
            @if (Model.Leaves.Count == 0)
            {
                <p class="text-muted mb-0">None.</p>
            }
            @foreach (var l in Model.Leaves)
            {
                <div class="small border-bottom py-1">
                    @l.StartDate.ToString("d MMM") @(l.EndDate != l.StartDate ? "- " + l.EndDate.ToString("d MMM") : "")
                    @(l.IsWholeDay ? "(full day)" : $"({l.StartTime:HH:mm}-{l.EndTime:HH:mm})")
                    <span class="badge bg-light text-dark">@l.Status</span> @l.Reason
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <form asp-action="Save" method="post" class="card-clean mb-4">
            <h2 class="h6 mb-3">@(editing ? "Edit working day" : "Add working day")</h2>
            <input type="hidden" asp-for="Form.ScheduleId" />
            <input type="hidden" asp-for="Form.DoctorId" />

            <div class="mb-2">
                <label class="form-label small" asp-for="Form.DayOfWeek">Day</label>
                <select asp-for="Form.DayOfWeek" class="form-select form-select-sm">
                    @foreach (var d in days)
                    {
                        <option value="@d.Value">@d.Name</option>
                    }
                </select>
            </div>
            <div class="row g-2 mb-2">
                <div class="col"><label class="form-label small">Start</label><input asp-for="Form.StartTime" type="time" class="form-control form-control-sm" /></div>
                <div class="col"><label class="form-label small">End</label><input asp-for="Form.EndTime" type="time" class="form-control form-control-sm" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col"><label class="form-label small">Break start</label><input asp-for="Form.BreakStart" type="time" class="form-control form-control-sm" /></div>
                <div class="col"><label class="form-label small">Break end</label><input asp-for="Form.BreakEnd" type="time" class="form-control form-control-sm" /></div>
            </div>
            <div class="mb-2">
                <label class="form-label small">Slot length (minutes)</label>
                <input asp-for="Form.SlotDurationMinutes" type="number" min="5" max="240" class="form-control form-control-sm" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col"><label class="form-label small">From</label><input asp-for="Form.EffectiveFrom" type="date" class="form-control form-control-sm" /></div>
                <div class="col"><label class="form-label small">Until (optional)</label><input asp-for="Form.EffectiveTo" type="date" class="form-control form-control-sm" /></div>
            </div>
            <button class="btn btn-primary btn-sm">@(editing ? "Save changes" : "Add")</button>
            @if (editing)
            {
                <a asp-action="Edit" asp-route-doctorId="@Model.Doctor.DoctorId" class="btn btn-link btn-sm">Cancel</a>
            }
        </form>

        <form asp-action="AddLeave" method="post" class="card-clean">
            <h2 class="h6 mb-3">Record leave</h2>
            <input type="hidden" asp-for="LeaveForm.DoctorId" />
            <div class="row g-2 mb-2">
                <div class="col"><label class="form-label small">From</label><input asp-for="LeaveForm.StartDate" type="date" class="form-control form-control-sm" /></div>
                <div class="col"><label class="form-label small">To</label><input asp-for="LeaveForm.EndDate" type="date" class="form-control form-control-sm" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col"><label class="form-label small">Start time (optional)</label><input asp-for="LeaveForm.StartTime" type="time" class="form-control form-control-sm" /></div>
                <div class="col"><label class="form-label small">End time (optional)</label><input asp-for="LeaveForm.EndTime" type="time" class="form-control form-control-sm" /></div>
            </div>
            <div class="mb-3"><label class="form-label small">Reason</label><input asp-for="LeaveForm.Reason" class="form-control form-control-sm" /></div>
            <button class="btn btn-outline-primary btn-sm">Record leave</button>
            <p class="text-muted small mt-2 mb-0">Leave blank times for full-day leave.</p>
        </form>
    </div>
</div>
