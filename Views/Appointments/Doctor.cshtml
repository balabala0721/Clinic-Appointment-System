@model DoctorAppointmentsViewModel
@{
    ViewData["Title"] = "My appointments";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var today = ClinicClock.Today;
    var heading = Model.AllDates ? "All dates" : Model.Date.HasValue ? Ui.DayDate(Model.Date.Value) : "";
}

<div class="page-header">
    <div>
        <h1>Appointments</h1>
        <p class="page-subtitle">@heading@(string.IsNullOrEmpty(Model.Status) ? "" : " · " + Ui.StatusLabel(Model.Status))</p>
    </div>
    <div class="page-actions">
        <a asp-controller="DoctorSchedules" asp-action="Mine" class="btn btn-secondary"><i class="bi bi-calendar-week" aria-hidden="true"></i> Schedule &amp; leave</a>
    </div>
</div>

<form method="get" class="card-clean filter-bar" role="search" aria-label="Filter appointments">
    <div class="filter-field">
        <label class="form-label" for="f-date">Date</label>
        <input id="f-date" type="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="filter-field">
        <label class="form-label" for="f-status">Status</label>
        <select id="f-status" name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in AppointmentStatus.All)
            {
                <option value="@s" selected="@(s == Model.Status)">@Ui.StatusLabel(s)</option>
            }
        </select>
    </div>
    <div class="filter-field">
        <div class="form-check mt-4">
            <input class="form-check-input" type="checkbox" name="allDates" value="true" id="allDates" checked="@Model.AllDates" />
            <label class="form-check-label" for="allDates">Show all dates</label>
        </div>
    </div>
    <div class="filter-actions">
        <button class="btn btn-primary">Apply</button>
        <a class="btn btn-secondary" asp-action="Doctor">Today</a>
    </div>
</form>

<div class="card-clean @(Model.Appointments.Count > 0 ? "card-table" : "")">
    @if (Model.Appointments.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon" aria-hidden="true"><i class="bi bi-calendar"></i></div>
            <div class="empty-title">No appointments match</div>
            <p class="empty-text">Try another date, or show all dates.</p>
            <a class="btn btn-outline-primary" asp-action="Doctor" asp-route-allDates="true">Show all dates</a>
        </div>
    }
    else
    {
        <table class="table table-stack">
            <thead><tr><th scope="col">Date</th><th scope="col">Time</th><th scope="col">Patient</th><th scope="col">Reason for visit</th><th scope="col">Status</th><th scope="col" class="actions"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var a in Model.Appointments)
                {
                    // Completed / No-show can only be recorded on or after the appointment day
                    var next = AppointmentStatus.NextFor(a.Status, isDoctor: true)
                                   .Where(s => !AppointmentStatus.OutcomeStatuses.Contains(s) || a.AppointmentDate <= today)
                                   .ToList();
                    var patient = a.Patient?.User.FullName ?? "Patient";
                    <tr>
                        <td data-label="Date">@Ui.Date(a.AppointmentDate)</td>
                        <td data-label="Time">@Ui.Time(a.StartTime)</td>
                        <td data-label="Patient">@patient</td>
                        <td data-label="Reason" class="small">@(a.ReasonForVisit ?? "-")</td>
                        <td data-label="Status">@Ui.StatusBadge(a.Status)</td>
                        <td class="actions">
                            @if (next.Count > 0)
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline-flex gap-2 m-0">
                                    <input type="hidden" name="id" value="@a.AppointmentId" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    @foreach (var s in next)
                                    {
                                        if (s == AppointmentStatus.NoShow)
                                        {
                                            <button name="status" value="@s" class="btn btn-outline-danger btn-sm"
                                                    data-confirm="@patient will be marked as not attending the appointment on @Ui.Date(a.AppointmentDate) at @Ui.Time(a.StartTime). This can't be undone."
                                                    data-confirm-title="Mark as no-show?" data-confirm-ok="Mark no-show">No-show</button>
                                        }
                                        else
                                        {
                                            <button name="status" value="@s" class="btn btn-primary btn-sm">@Ui.StatusLabel(s)</button>
                                        }
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <partial name="_Pager" model="@(new PagerModel(Model.Page, Model.Appointments.Count == ClinicSettings.AdminPageSize))" />
</div>
