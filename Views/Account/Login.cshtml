@model List<ClinicSystem.Controllers.DevLoginUser>
@{
    ViewData["Title"] = "Test login";
    // Order the groups the way you'd test: patient first, then doctor, then admin side
    var roleOrder = new[] { Roles.Patient, Roles.Doctor, Roles.Staff, Roles.Admin };
}

<div class="card-clean dialog-card">
    <h1 class="h4 mb-1">Test login</h1>
    <p class="text-muted mb-4">Development only - choose a user to sign in as them. No password needed.</p>

    @if (ViewBag.DbNotReady == true)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-database-exclamation" aria-hidden="true"></i>
            <div>
                The database isn't ready. In <strong>Tools &gt; NuGet Package Manager &gt; Package Manager Console</strong> run
                <code>Update-Database</code>, then restart the app.
                Check the Output window for "Database migration/seeding failed" if it still appears.
            </div>
        </div>
    }
    else if (Model.Count == 0)
    {
        <div class="alert alert-warning" role="alert"><i class="bi bi-people" aria-hidden="true"></i><div>No users found. Restart the app to create the demo data.</div></div>
    }

    @foreach (var role in roleOrder)
    {
        var group = Model.Where(u => u.Role == role).ToList();
        if (group.Count == 0) { continue; }

        <h2 class="side-nav-label px-0 mt-3">@AppNav.RoleLabel(role)</h2>
        <div class="d-flex flex-column gap-2">
            @foreach (var u in group)
            {
                <form asp-action="Login" method="post" class="m-0">
                    <input type="hidden" name="userId" value="@u.UserId" />
                    <button class="choice w-100 text-start" data-busy-text="Signing in...">
                        <span class="avatar" aria-hidden="true">@Ui.Initials(u.DisplayName)</span>
                        <span class="min-w-0">
                            <span class="choice-title d-block">@u.DisplayName</span>
                            <span class="choice-sub d-block text-truncate">@u.Email</span>
                        </span>
                        <i class="bi bi-chevron-right choice-end" aria-hidden="true"></i>
                    </button>
                </form>
            }
        </div>
    }

    <hr class="my-4" />
    <div class="d-flex flex-wrap justify-content-between gap-2">
        <a asp-action="Register" asp-controller="Acc" class="btn btn-link px-0">Register a patient account</a>
        <form asp-action="ResetDemoData" method="post" class="m-0"
              data-confirm="All appointments and leave will be deleted and the demo ones restored. Users are kept."
              data-confirm-title="Reset demo data?" data-confirm-ok="Reset demo data">
            <button class="btn btn-link text-danger px-0">Reset demo appointments &amp; leave</button>
        </form>
    </div>
</div>
