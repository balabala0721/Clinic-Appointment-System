@{
    ViewData["Title"] = "Access denied";
}
<div class="card-clean mx-auto text-center" style="max-width: 480px">
    <h1 class="h5">This page isn't available for your role</h1>
    <p class="text-muted">You're signed in as <strong>@User.Identity?.Name</strong>.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Switch user</a>
</div>
