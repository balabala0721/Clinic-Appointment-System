@using ClinicSystem.Models.Entities
@model IEnumerable<ClinicSystem.Models.Entities.Drug>

@{
    ViewData["Title"] = "Drug List";
}

<div class="container mt-4">


    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Drug Management</h2>

        @if (User.IsInRole("Admin"))
        {
            <div>
                <a asp-action="LowStock" class="btn btn-warning me-2">
                    <i class="bi bi-exclamation-triangle"></i>
                    Low Stock Alert
                </a>

                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    Add New Drug
                </a>
            </div>
        }
    </div>

    
    @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <strong>Filter Drugs</strong>
            </div>

            <div class="card-body">
                <form asp-action="Index" method="get">
                    <div class="row">

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Drug Category</label>
                            <select name="category"
                                    class="form-select"
                                    asp-items="ViewBag.DrugCategories">
                                <option value="">All Categories</option>
                            </select>
                        </div>

                        <div class="col-md-2 mb-3">
                            <label class="form-label">Minimum Price (RM)</label>
                            <input type="number"
                                   name="minPrice"
                                   class="form-control"
                                   value="@ViewBag.MinPrice"
                                   min="0"
                                   step="0.01" />
                        </div>

                        <div class="col-md-2 mb-3">
                            <label class="form-label">Maximum Price (RM)</label>
                            <input type="number"
                                   name="maxPrice"
                                   class="form-control"
                                   value="@ViewBag.MaxPrice"
                                   min="0"
                                   step="0.01" />
                        </div>

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Medical Uses</label>
                            <input type="text"
                                   name="medicalUses"
                                   class="form-control"
                                   value="@ViewBag.MedicalUses"
                                   placeholder="Search medical uses..." />
                        </div>

                        <div class="col-md-2 mb-3">
                            <label class="form-label">Stock Availability</label>
                            <select name="stockAvailability" class="form-select">
                                <option value="">All</option>
                                <option value="InStock"
                                        selected="@(ViewBag.StockAvailability == "InStock")">
                                    In Stock
                                </option>
                                <option value="LowStock"
                                        selected="@(ViewBag.StockAvailability == "LowStock")">
                                    Low Stock
                                </option>
                                <option value="OutOfStock"
                                        selected="@(ViewBag.StockAvailability == "OutOfStock")">
                                    Out of Stock
                                </option>
                            </select>
                        </div>

                    </div>

                    <button type="submit" class="btn btn-primary">
                        Apply Filters
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Clear Filters
                    </a>



                </form>
            </div>
        </div>
    }


    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@(ViewBag.SortOrder == "id_asc" ? "id_desc" : "id_asc")"
                       asp-route-category="@Context.Request.Query["category"]"
                       asp-route-minPrice="@Context.Request.Query["minPrice"]"
                       asp-route-maxPrice="@Context.Request.Query["maxPrice"]"
                       asp-route-medicalUses="@Context.Request.Query["medicalUses"]"
                       asp-route-stockAvailability="@Context.Request.Query["stockAvailability"]">
                        Drug ID
                        @(ViewBag.SortOrder == "id_asc" ? "▲" :
                          ViewBag.SortOrder == "id_desc" ? "▼" : "▲")
                    </a>
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@(ViewBag.SortOrder == "name_asc" ? "name_desc" : "name_asc")"
                       asp-route-category="@Context.Request.Query["category"]"
                       asp-route-minPrice="@Context.Request.Query["minPrice"]"
                       asp-route-maxPrice="@Context.Request.Query["maxPrice"]"
                       asp-route-medicalUses="@Context.Request.Query["medicalUses"]"
                       asp-route-stockAvailability="@Context.Request.Query["stockAvailability"]">
                        Drug Name
                        @(ViewBag.SortOrder == "name_asc" ? "▲" :
                          ViewBag.SortOrder == "name_desc" ? "▼" : "▲")
                    </a>
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@(ViewBag.SortOrder == "category_asc" ? "category_desc" : "category_asc")"
                       asp-route-category="@Context.Request.Query["category"]"
                       asp-route-minPrice="@Context.Request.Query["minPrice"]"
                       asp-route-maxPrice="@Context.Request.Query["maxPrice"]"
                       asp-route-medicalUses="@Context.Request.Query["medicalUses"]"
                       asp-route-stockAvailability="@Context.Request.Query["stockAvailability"]">
                        Category
                        @(ViewBag.SortOrder == "category_asc" ? "▲" :
                          ViewBag.SortOrder == "category_desc" ? "▼" : "▲")
                    </a>
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@(ViewBag.SortOrder == "price_asc" ? "price_desc" : "price_asc")"
                       asp-route-category="@Context.Request.Query["category"]"
                       asp-route-minPrice="@Context.Request.Query["minPrice"]"
                       asp-route-maxPrice="@Context.Request.Query["maxPrice"]"
                       asp-route-medicalUses="@Context.Request.Query["medicalUses"]"
                       asp-route-stockAvailability="@Context.Request.Query["stockAvailability"]">
                        Unit Price
                        @(ViewBag.SortOrder == "price_asc" ? "▲" :
                          ViewBag.SortOrder == "price_desc" ? "▼" : "▲")
                    </a>
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@(ViewBag.SortOrder == "stock_asc" ? "stock_desc" : "stock_asc")"
                       asp-route-category="@Context.Request.Query["category"]"
                       asp-route-minPrice="@Context.Request.Query["minPrice"]"
                       asp-route-maxPrice="@Context.Request.Query["maxPrice"]"
                       asp-route-medicalUses="@Context.Request.Query["medicalUses"]"
                       asp-route-stockAvailability="@Context.Request.Query["stockAvailability"]">
                        Stock Quantity
                        @(ViewBag.SortOrder == "stock_asc" ? "▲" :
                          ViewBag.SortOrder == "stock_desc" ? "▼" : "▲")

                    </a>
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@(ViewBag.SortOrder == "status_asc" ? "status_desc" : "status_asc")"
                       asp-route-category="@Context.Request.Query["category"]"
                       asp-route-minPrice="@Context.Request.Query["minPrice"]"
                       asp-route-maxPrice="@Context.Request.Query["maxPrice"]"
                       asp-route-medicalUses="@Context.Request.Query["medicalUses"]"
                       asp-route-stockAvailability="@Context.Request.Query["stockAvailability"]">
                        Stock Status
                        @(ViewBag.SortOrder == "status_asc" ? "▲" :
                          ViewBag.SortOrder == "status_desc" ? "▼" : "▲")
                    </a>
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@(ViewBag.SortOrder == "availability_asc" ? "availability_desc" : "availability_asc")"
                       asp-route-category="@Context.Request.Query["category"]"
                       asp-route-minPrice="@Context.Request.Query["minPrice"]"
                       asp-route-maxPrice="@Context.Request.Query["maxPrice"]"
                       asp-route-medicalUses="@Context.Request.Query["medicalUses"]"
                       asp-route-stockAvailability="@Context.Request.Query["stockAvailability"]">
                        Availability
                        @(ViewBag.SortOrder == "availability_asc" ? "▲" :
                          ViewBag.SortOrder == "availability_desc" ? "▼" : "▲")


                    </a>
                </th>
                <th>Action</th>
            </tr>
        </thead>


        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var drug in Model)
                {
                    <tr>
                        <td>@drug.DrugID</td>
                        <td>@drug.DrugName</td>
                        <td>@drug.DrugCategory</td>
                        <td>@drug.UnitPrice.ToString("F2")</td>
                        <td>@drug.StockQuantity</td>
                        <td>
                            @if (drug.StockStatus == StockStatus.InStock)
                            {
                                <span class="badge bg-success">In Stock</span>
                            }
                            else if (drug.StockStatus == StockStatus.LowStock)
                            {
                                <span class="badge bg-warning text-dark">Low Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                        </td>
                        <td>
                            @if (drug.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@drug.DrugID"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@drug.DrugID"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                @if (drug.IsActive)
                                {
                                    <a asp-action="Deactivate"
                                       asp-route-id="@drug.DrugID"
                                       class="btn btn-sm btn-danger">
                                        Deactivate
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Activate"
                                       asp-route-id="@drug.DrugID"
                                       class="btn btn-sm btn-success">
                                        Activate
                                    </a>
                                }
                            }
                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">
                        No drug records available.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
