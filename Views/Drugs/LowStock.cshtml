@model IEnumerable<ClinicSystem.Models.Entities.Drug>

@{
    ViewData["Title"] = "Low Stock Alert";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Low Stock Alert</h2>

        <a asp-action="Index" class="btn btn-secondary">
            Back to Drug List
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="alert alert-warning">
            <strong>Warning!</strong>
            The following drugs have stock quantities below their minimum stock levels.
        </div>

        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Drug ID</th>
                    <th>Drug Name</th>
                    <th>Category</th>
                    <th>Current Stock</th>
                    <th>Minimum Stock Level</th>
                    <th>Stock Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var drug in Model)
                {
                    <tr>
                        <td>@drug.DrugID</td>
                        <td>@drug.DrugName</td>
                        <td>@drug.DrugCategory</td>
                        <td>@drug.StockQuantity</td>
                        <td>@drug.MinStockLevel</td>
                        <td>
                            <span class="badge bg-warning text-dark">
                                Low Stock
                            </span>
                        </td>
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@drug.DrugID"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@drug.DrugID"
                               class="btn btn-sm btn-warning">
                                Update Stock
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-success">
            <strong>Good news!</strong>
            There are currently no low-stock drugs.
        </div>
    }

</div>
